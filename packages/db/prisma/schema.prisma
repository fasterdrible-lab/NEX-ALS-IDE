generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

// Serviço zeus-hermes na VPS (apps/server): mesmo schema, motor para Ubuntu 24.04 (OpenSSL 3).
// Fora de packages/db/generated para não entrar no instalador do Zeus.
generator server {
  provider      = "prisma-client-js"
  output        = "../../../apps/server/generated/prisma-client"
  binaryTargets = ["debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model VpsServer {
  id            String    @id @default(cuid())
  name          String
  host          String
  port          Int       @default(22)
  username      String
  defaultPath   String    @default("/root")
  sshPassword        String?
  sshHostFingerprint String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  projects       Project[]
  claudeAccounts ClaudeAccount[]
  hermesInstance HermesInstance?

  @@map("vps_servers")
}

model Project {
  id              String         @id @default(cuid())
  name            String
  description     String         @default("")
  /// Pasta do projeto no PC ("" = sem pasta local). Project First (v3.84.0): local, VPS ou os dois.
  localPath       String         @default("")
  /// Pasta na VPS ("" = sem VPS).
  remotePath      String         @default("")
  gitRepo         String         @default("")
  vpsServerId     String?
  claudeAccountId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  /// SetNull: apagar uma VPS não apaga mais os projetos dela (até v3.83 era Cascade).
  vpsServer     VpsServer?     @relation(fields: [vpsServerId], references: [id], onDelete: SetNull)
  claudeAccount ClaudeAccount? @relation(fields: [claudeAccountId], references: [id], onDelete: SetNull)
  launchHistory LaunchHistory[]
  hermesAgent   HermesProjectAgent?

  @@map("projects")
}

model ClaudeAccount {
  id          String    @id @default(cuid())
  name        String
  email       String    @default("")
  vpsServerId String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  vpsServer VpsServer? @relation(fields: [vpsServerId], references: [id], onDelete: SetNull)
  projects  Project[]

  @@map("claude_accounts")
}

model Settings {
  id                 String   @id @default("default")
  vscodePath         String   @default("code")
  vscodeInsidersPath String   @default("code-insiders")
  sshKeyPath         String   @default("")
  updatedAt          DateTime @updatedAt

  @@map("settings")
}

model LaunchHistory {
  id         String   @id @default(cuid())
  projectId  String
  launchedAt DateTime @default(now())
  success    Boolean
  errorMsg   String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("launch_history")
}

model SquadSession {
  id        String   @id @default(cuid())
  title     String   @default("Nova sessão")
  agentName String
  projectId String?
  vpsId     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages SquadMessage[]

  @@map("squad_sessions")
}

model SquadMessage {
  id          String   @id @default(cuid())
  sessionId   String
  agentName   String
  role        String
  content     String
  delegatedBy String?
  createdAt   DateTime @default(now())

  session SquadSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("squad_messages")
}

model SquadMemory {
  id         String   @id @default(cuid())
  projectKey String
  content    String
  category   String   @default("decisão")
  sessionId  String?
  agentName  String   @default("jarvis")
  createdAt  DateTime @default(now())

  @@index([projectKey])
  @@map("squad_memories")
}

model HermesInstance {
  id          String    @id @default(cuid())
  vpsServerId String    @unique
  status      String    @default("unknown") // unknown|not_installed|installed|running|stopped|error
  version     String    @default("")
  installPath String    @default("")
  pid         Int?
  lastSeen    DateTime?
  lastError   String    @default("")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  vpsServer VpsServer @relation(fields: [vpsServerId], references: [id], onDelete: Cascade)
  projectAgents HermesProjectAgent[]

  @@map("hermes_instances")
}

model HermesProjectAgent {
  id               String    @id @default(cuid())
  projectId        String    @unique
  hermesInstanceId String
  workspace        String
  status           String    @default("idle") // idle|running|error
  sessionStarted   Boolean   @default(false)
  lastActivity     DateTime?
  lastError        String    @default("")
  objective        String    @default("")
  autonomyLevel    String    @default("manual") // manual (Assistido)|semi|autonomous
  dodChecklist     String    @default("[]")     // JSON: [{id,label,done,auto}]
  devRules         String    @default("")       // Development Rules do projeto → .hermes.md
  baseCommit       String    @default("")       // HEAD quando o objetivo começou — base do diff da revisão
  delivery         String    @default("{}")     // JSON: DeliveryResult do último fechamento de entrega
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  hermesInstance HermesInstance @relation(fields: [hermesInstanceId], references: [id], onDelete: Cascade)

  @@map("hermes_project_agents")
}

model KnowledgeEntry {
  id        String   @id @default(cuid())
  title     String
  content   String
  category  String   @default("geral")
  tags      String   @default("")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("knowledge_entries")
}
