{
  "name": "@cwm/desktop",
  "version": "3.19.0",
  "description": "NEX-ALS IDE — gerenciador de ambientes VPS com IDE integrado",
  "author": "NEX-ALS",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "package": "electron-vite build && electron-builder",
    "package:win": "electron-vite build && electron-builder --win",
    "package:dir": "electron-vite build && electron-builder --dir"
  },
  "dependencies": {
    "@cwm/config": "workspace:*",
    "@cwm/core": "workspace:*",
    "@cwm/db": "workspace:*",
    "electron-updater": "^6.8.3"
  },
  "devDependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@types/node": "^22.0.0",
    "concurrently": "^9.1.0",
    "electron": "^33.3.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^5.0.0",
    "playwright-core": "^1.60.0",
    "typescript": "^5.7.3"
  },
  "build": {
    "appId": "com.nexals.ide",
    "productName": "NEX-ALS IDE",
    "copyright": "Copyright © 2026 NEX-ALS",
    "directories": {
      "output": "dist-app"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NEX-ALS IDE",
      "deleteAppDataOnUninstall": false,
      "license": "LICENSE.txt"
    },
    "files": [
      {
        "from": ".",
        "to": ".",
        "filter": [
          "out/**",
          "package.json",
          "node_modules/**",
          "!node_modules/@cwm/**"
        ]
      },
      {
        "from": "../../packages/config",
        "to": "node_modules/@cwm/config",
        "filter": [
          "dist/**",
          "package.json"
        ]
      },
      {
        "from": "../../packages/db",
        "to": "node_modules/@cwm/db",
        "filter": [
          "dist/**",
          "generated/**",
          "package.json"
        ]
      },
      {
        "from": "../../packages/core",
        "to": "node_modules/@cwm/core",
        "filter": [
          "dist/**",
          "package.json"
        ]
      }
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "renderer"
      }
    ],
    "asar": false,
    "npmRebuild": false,
    "publish": {
      "provider": "github",
      "owner": "fasterdrible-lab",
      "repo": "HEXAGON-WORKSPACE-MANAGER"
    }
  }
}
