{
  "name": "nex-als-ide",
  "version": "3.57.3",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:inner": "concurrently -n WEB,DESKTOP -c cyan,yellow \"pnpm --filter web dev\" \"wait-on http://localhost:5173 && pnpm --filter desktop dev\"",
    "build:pkgs": "pnpm --filter @cwm/config build && pnpm --filter @cwm/db build && pnpm --filter @cwm/core build",
    "build": "pnpm run build:pkgs && pnpm --filter web build && pnpm --filter desktop build",
    "package:win": "pnpm build && pnpm --filter @cwm/desktop package:win",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:ci": "pnpm build && playwright test --config e2e/playwright.config.ts",
    "db:generate": "pnpm --filter @cwm/db generate",
    "db:push": "pnpm --filter @cwm/db db:push",
    "db:studio": "pnpm --filter @cwm/db studio"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.3.0",
    "typescript": "^5.7.3",
    "wait-on": "^8.0.1"
  },
  "pnpm": {
    "approvedBuiltDependencies": ["cpu-features", "ssh2"]
  }
}

